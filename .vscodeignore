# Allow-list: ignore everything, then re-include only what the extension needs at runtime.
# vsce always adds package.json and the README passed with --readme-path.
# tests/unit/packaging.test.ts checks the resulting file list.
**
!dist/extension.js
!main_scripts/**
!node_modules/ws/**
!media/icon.png
!media/background-mode.png
!LICENSE
!CHANGELOG.md
